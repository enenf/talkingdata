# OpenAI-compatible Responses endpoint.
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_API_KEY=replace-me
MODEL_NAME=your-model
MODEL_WIRE_API=responses
# Keep enabled for the exam provider; disables unsupported optional CLI fields.
MODEL_COMPAT_MODE=1
# Robustness for providers with unstable streamed tool arguments (0: pass SSE).
MODEL_BUFFERED=1
# To pass requests directly to a fully compatible provider: MODEL_COMPAT_MODE=0
# APP_TOKEN=optional-local-access-password
# RUN_TIMEOUT_SECONDS=600
